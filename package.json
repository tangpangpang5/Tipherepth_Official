{
  "name": "tipherepth-music",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Tiphereth Archive music station: 3D cassette wall over a local music library",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "scan": "node scripts/scan-audio.mjs --out public/data",
    "palette": "node scripts/palette.mjs --data public/data --public public",
    "transcode": "node scripts/transcode.mjs --data public/data --public public"
  },
  "dependencies": {
    "music-metadata": "^11.16.0",
    "opencc-js": "^1.4.2",
    "three": "^0.183.0"
  },
  "devDependencies": {
    "sharp": "^0.33.5",
    "vite": "^7.3.7"
  }
}
